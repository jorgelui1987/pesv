# ============================================
# PESV Integral - Plantilla de Configuración
# ============================================
# Copia este archivo a ".env" y ajusta los valores:
#   cp .env.example .env   (Linux/Mac)
#   copy .env.example .env (Windows)

# --- Servidor ---
PORT=3000

# --- Base de Datos PostgreSQL ---
DB_CONNECTION=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=tu_base_de_datos
DB_USERNAME=tu_usuario
DB_PASSWORD=tu_contraseña
# Opcional: activar SSL para proveedores cloud (Railway, Docploy, Heroku, etc.)
DB_SSL=false
# Alternativa: usar una URL de conexión completa (opcional, reemplaza las variables DB_*)
# DATABASE_URL=postgresql://usuario:password@host:puerto/base_de_datos?sslmode=require

# --- URL de la Aplicación ---
APP_URL=tu-dominio.sslip.io

# --- Seguridad / JWT ---
# IMPORTANTE: Usa una clave secreta larga y aleatoria en producción
JWT_SECRET=cambia_esta_clave_secreta_por_una_segura